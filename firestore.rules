rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get: if request.auth != null
        && request.auth.uid == userId
        && resource.data.status == "active";
      allow list, create, update, delete: if false;
    }

    match /auditLogs/{eventId} {
      allow read, write: if false;
    }

    match /membershipQuotas/{userId} {
      allow read, create, update, delete: if false;
    }

    match /rateLimitCounters/{counterId} {
      allow read, create, update, delete: if false;
    }

    function accountIsActive() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function organizationIsActive(organizationId) {
      return get(/databases/$(database)/documents/organizations/$(organizationId)).data.status == "active";
    }

    match /organizations/{organizationId} {
      allow read, write: if false;

      match /memberships/{memberId} {
        allow get: if accountIsActive()
          && request.auth.uid == memberId
          && organizationIsActive(organizationId)
          && resource.data.organizationId == organizationId
          && resource.data.uid == memberId
          && resource.data.status == "active";
        allow list, create, update, delete: if false;
      }
    }

    match /contributions/{contributionId} {
      allow read, write: if false;
      match /assets/{assetId} {
        allow read, write: if false;
      }
      match /rights/{rightsId} {
        allow read, write: if false;
      }
      match /consents/{consentId} {
        allow read, write: if false;
      }
      match /{subdocument=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
